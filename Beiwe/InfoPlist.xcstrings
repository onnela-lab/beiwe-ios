          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於ResearchKit的醫學研究"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "InfoPlist.strings\n We had some difficulty after a release rejection due to new policy on sensor usage statements,\n and had to put some options together.\n\n This language was not submitted:\n NSHealthShareUsageDescription = \"Beiwe needs to access your Apple Health data in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. This data may be used for the development of novel statistical methods particularly in the fields of Digital Phenotyping and Statistical Network Science.\";\n NSHealthUpdateUsageDescription = \"Beiwe needs to access your Apple Health data in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. This data may be used for the development of novel statistical methods particularly in the fields of Digital Phenotyping and Statistical Network Science.\";\n NSLocationAlwaysAndWhenInUseUsageDescription = \"Beiwe needs to access your Location data in the background in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. This data may be used for the development of novel statistical methods particularly in the fields of Digital Phenotyping and Statistical Network Science.\";\n NSLocationAlwaysUsageDescription = \"Beiwe needs to access your Location data in the background in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. This data may be used for the development of novel statistical methods particularly in the fields of Digital Phenotyping and Statistical Network Science.\";\n NSLocationWhenInUseUsageDescription = \"Beiwe needs to access your Location data in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. This data may be used for the development of novel statistical methods particularly in the fields of Digital Phenotyping and Statistical Network Science.\";\n NSMotionUsageDescription = \"Beiwe needs to access your Device's Motion data in the background in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. This data may be used for the development of novel statistical methods particularly in the fields of Digital Phenotyping and Statistical Network Science.\";\n NSMicrophoneUsageDescription = \"Beiwe needs access to your microphone in order to record your ressponse to an audio survey.\";\n\n This language was submitted and approved:",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für medizinische Forschung mit ResearchKit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe needs to access your Apple Health data in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. The Beiwe app does not use or process the data it collects. All data recorded during studies are securely uploaded to a server and accessed solely by authorized researchers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la ricerca medica con ResearchKit"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe需要访问您的Apple健康数据，以便为您所参与的医学、临床或学术及科学研究项目收集数据。Beiwe应用本身不会使用或处理其收集的数据。研究期间记录的所有数据都会安全地上传至服务器，仅由授权的研究人员访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於ResearchKit的醫學研究"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
