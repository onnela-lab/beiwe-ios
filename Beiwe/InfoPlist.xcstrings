    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe braucht Zugriff auf Ihre Sensoren, um die Studie optimal durchführen zu können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe needs to access your Device's Motion data in order to collect data for the medical, clinical, or academic and scientific research goals of the study you have enrolled in. The Beiwe app does not use or process the data it collects. All data recorded during studies are securely uploaded to a server and accessed solely by authorized researchers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe ha bisogno dell'accesso ai sensori dello smarpthone per condurre correttamente la ricerca medica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe需要访问您设备的运动数据，以便为您所参与的医学、临床或学术及科学研究项目收集数据。Beiwe应用本身不会使用或处理其收集的数据。研究期间记录的所有数据都会安全地上传至服务器，仅由授权的研究人员访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe需要使用您的傳感器來正確進行醫學研究。"
          }
        }
      }
    },
