    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für medizinische Forschung mit ResearchKit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera - This feature is not in use by the Beiwe platform. If you see this message please report a bug with a screenshot to github.com/onnela-lab/beiwe-ios/issues/"
          }
        },
        "it" : {
          "stringUnit" : {
