    "http_message_400" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät konnte nicht mit diesem Benutzername registriert werden. Bitte wenden Sie sich an das Personal Ihrer Studie. Fehlercode 400."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device could not be registered under the provided patient ID.  Please contact your study administrator"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile registrare il dispositivo con questo account. Contatta il personale dello studio. Codice errore 400."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该设备无法透过此账号注册，请与研究团队联系，错误代码:400"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該設備無法透過此帳號註冊，請與研究團隊聯繫，錯誤代碼:400"
