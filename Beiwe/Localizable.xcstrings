    "default_survey_submit_success_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielen Dank für das Ausfüllen dieses Fragebogens. Ein Arzt wird Ihre Antworten nicht sofort sehen. Wenn Sie also Hilfe benötigen oder daran denken, sich selbst zu verletzen, wenden Sie sich bitte an Ihren Arzt. Sie können auch auf die Schaltfläche \"Forschungsteam kontaktieren\" klicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks! You have finished answering all of the survey questions.  Pressing the submit button will now schedule your answers to be delivered"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie! Hai finito di rispondere a tutte le domande del sondaggio. Premendo il pulsante di invio ora verranno programmate le risposte da consegnare"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢您完成此份问卷，研究团队无法立即更新问卷资讯，若资料上传过程当中您有任何问题，请与研究团队联系。您可以通过”与研究团队联系”按键，向我们反馈"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感謝您完成此份問卷，研究團隊無法立即更新問卷資訊，若資料上傳過程當中您有任何問題，請與研究團隊連繫。您可以透過”與研究團隊聯繫”鍵，向我們反應"
          }
        }
      }
    },
