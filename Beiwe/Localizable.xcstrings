    "forgot_password_title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenden Sie sich bitte an die Studienunterstützung und teilen Sie ihnen Ihren Benutzernamen mit, damit sie Ihnen ein vorläufiges Passwort geben können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
