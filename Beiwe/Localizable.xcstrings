    "welcome_screen_body_text" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen in der Beiwe-App. Um die Einrichtung der App zu erleichtern, halten Sie bitte die schriftliche App-Anleitung mit Benutzername, Passwort und anderen für die Registrierung erforderlichen Informationen bereit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to the Beiwe Research Platform. Please have your user ID and password, which were given to you by your clinician, available as you begin the registration process."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuto in Beiwe. Per avviare il processo di registrazione, inserisci l'ID utente e la password che ti sono stati forniti dal personale dello studio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
