    "permission_location_and_notification_message_long" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Beiwe muss auf Ihren GPS-Standort zugreifen, um die Studie durchführen zu können. Bitte aktivieren Sie die Ortungsdienste für die Beiwe-App in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe needs access to your location for the passive data gathering capabilities of this app. Beiwe will also send you notifications to notify you of new surveys."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe ha bisogno di accedere alla tua posizione GPS per condurre la ricerca. Attiva l'autorizzazione GPS per Beiwe nelle impostazioni"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Beiwe 需要获取您的位置信息，用于正确的数据收集。并且Beiwe将通过消息推送，提醒您提交问卷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Beiwe 需要連結您的位置資訊，以利整合軟體的資訊內容，並且Beiwe將提供您問卷新增的提示"
          }
        }
      }
    },
    "permission_warning_alert_text" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe muss auf Ihren GPS-Standort zugreifen, um die Studie durchführen zu können. Bitte aktivieren Sie die Ortungsdienste für die Beiwe-App in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission to access your location and send notifications is required to correctly gather the data required for this study.  To participate in this study we highly recommend you go back and allow this application to access your location and send notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe ha bisogno di accedere alla tua posizione GPS per condurre la ricerca. Attiva l'autorizzazione GPS per Beiwe nelle impostazioni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe需要获取手机的位置信息功能，以正确获取研究信息。为了研究目的，我们建议您至设定开启位置信息的允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiwe需要連結手機的位置資訊功能，以利正確蒐集蒐集研究資訊。為了研究目的，我們建議您至設定開啟位置資訊的允許。"
          }
        }
      }
    },
